DATA_DIR=/mnt/data-dir
RELAY_URL=http://192.168.86.65:8050

# ── Relay fold-in (docs/relay-fold-in.md) ────────────────────────────────────
# Global forward: every migrated /relay route proxies back to the relay until
# its cutover window marks it journal-owned via RELAY_FORWARD_<FEATURE>=local.
# Window flips (=local lines, ENABLE_SCHEDULERS, SCHED_<X>=off, secrets like
# ITAD_API_KEY) live in the UNTRACKED /home/jarcher/gaming-journal/.env.local —
# never here; this file is committed and deploys overwrite it.
RELAY_FORWARD=http://localhost:8050
SCHED_DISK_USAGE=off
PUPPETEER_CACHE_DIR=/home/jarcher/gaming-journal/.puppeteer-cache
