DATA_DIR=/mnt/data-dir

# ── Relay fold-in (docs/relay-fold-in.md) ────────────────────────────────────
# All gaming features are journal-owned. Relay decommissioned 2026-07-17: the
# standalone process is gone, RELAY_URL + the /relay/[...path] catch-all proxy +
# the /api/config endpoint have been removed. Secrets + ENABLE_SCHEDULERS live in
# the UNTRACKED /home/jarcher/gaming-journal/.env.local — never here; this file
# is committed and deploys overwrite it.
SCHED_DISK_USAGE=off
PUPPETEER_CACHE_DIR=/home/jarcher/gaming-journal/.puppeteer-cache
