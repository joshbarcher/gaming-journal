{
    "name": "gaming-journal",
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "dev": "node --env-file .env start.js",
        "build": "node scripts/build.mjs",
        "preview": "node --env-file .env build/index.js",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "posttest:coverage": "node coverage.js --snapshot",
        "test:watch": "vitest",
        "typecheck": "svelte-check --tsconfig ./tsconfig.json",
        "verify-contracts": "tsx scripts/verify-contracts.ts"
    },
    "devDependencies": {
        "@playwright/test": "^1.60.0",
        "@sveltejs/adapter-node": "^5.5.4",
        "@sveltejs/kit": "^2.65.0",
        "@sveltejs/vite-plugin-svelte": "^7.1.2",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/svelte": "^5.3.1",
        "@types/jsdom": "^28.0.3",
        "@types/node": "^25.9.3",
        "@vitest/coverage-v8": "^4.1.8",
        "jsdom": "^29.1.1",
        "svelte": "^5.56.3",
        "svelte-check": "^4.6.0",
        "tsx": "^4.22.4",
        "typescript": "^6.0.3",
        "vite": "^8.0.16",
        "vitest": "^4.1.8"
    },
    "overrides": {
        "cookie": "^0.7.0"
    },
    "dependencies": {
        "@archerjb/ui-components": "^1.5.0",
        "cheerio": "^1.2.0",
        "fuse.js": "^7.4.2",
        "minisearch": "^7.2.0",
        "overlayscrollbars": "^2.16.0",
        "overlayscrollbars-svelte": "^0.5.5",
        "puppeteer": "^25.3.0",
        "puppeteer-extra": "^3.3.6",
        "puppeteer-extra-plugin-stealth": "^2.11.2",
        "sharp": "^0.35.3",
        "zod": "^4.4.3"
    }
}
