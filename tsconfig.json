{
    "extends": "./.svelte-kit/tsconfig.json",
    "compilerOptions": {
        "strict": true,
        "allowJs": true,
        "checkJs": false,
        // puppeteer-extra's bundled types clash with current puppeteer's
        // (executablePath signature) — skip declaration-file checking, which is
        // also the common default for SvelteKit projects.
        "skipLibCheck": true
    }
}
